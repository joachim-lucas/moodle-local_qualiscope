<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/qualiscope/db" VERSION="2026092401" COMMENT="XMLDB file for Moodle local/qualiscope"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_qualiscope_referentials" COMMENT="List of quality referentials (e.g. Qualiopi, IACET...).">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key."/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Referential name."/>
        <FIELD NAME="version" TYPE="char" LENGTH="50" NOTNULL="true"  SEQUENCE="false" COMMENT="Referential version."/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"  SEQUENCE="false" COMMENT="Referential description."/>
        <FIELD NAME="active" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="1 if active, 0 if inactive."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time created."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time modified."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key."/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_qualiscope_criteria" COMMENT="Criteria belonging to a referential.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key."/>
        <FIELD NAME="referential_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to referentials."/>
        <FIELD NAME="number" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Criterion number."/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Criterion title."/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"  SEQUENCE="false" COMMENT="Criterion description."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time created."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time modified."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key."/>
        <KEY NAME="referential" TYPE="foreign" FIELDS="referential_id" REFTABLE="local_qualiscope_referentials" REFFIELDS="id" COMMENT="FK to referentials."/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="referential_number" UNIQUE="true" FIELDS="referential_id, number" COMMENT="Unique referential + number."/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_qualiscope_indicators" COMMENT="Indicators belonging to a criterion.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key."/>
        <FIELD NAME="criterion_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to criteria."/>
        <FIELD NAME="number" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Indicator number."/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Indicator title."/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"  SEQUENCE="false" COMMENT="Indicator description."/>
        <FIELD NAME="scope" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="course" SEQUENCE="false" COMMENT="Scope of the indicator."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time created."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time modified."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key."/>
        <KEY NAME="criterion" TYPE="foreign" FIELDS="criterion_id" REFTABLE="local_qualiscope_criteria" REFFIELDS="id" COMMENT="FK to criteria."/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="criterion_number" UNIQUE="true" FIELDS="criterion_id, number" COMMENT="Unique criterion + number."/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_qualiscope_checks" COMMENT="Individual checks for each indicator.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key."/>
        <FIELD NAME="indicator_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to indicators."/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Check name."/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"  SEQUENCE="false" COMMENT="Check description."/>
        <FIELD NAME="type" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="manual" SEQUENCE="false" COMMENT="Check type."/>
        <FIELD NAME="automatic" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 if automatic."/>
        <FIELD NAME="weight" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Weight of the check."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time created."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time modified."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key."/>
        <KEY NAME="indicator" TYPE="foreign" FIELDS="indicator_id" REFTABLE="local_qualiscope_indicators" REFFIELDS="id" COMMENT="FK to indicators."/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_qualiscope_campaigns" COMMENT="Audit campaigns.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key."/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Campaign name."/>
        <FIELD NAME="referential_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to referentials."/>
        <FIELD NAME="scope" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="all" SEQUENCE="false" COMMENT="Scope type."/>
        <FIELD NAME="scopeids" TYPE="text" NOTNULL="false"  SEQUENCE="false" COMMENT="JSON list of scope IDs."/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Creator user ID."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time created."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time modified."/>
        <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Time completed."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key."/>
        <KEY NAME="referential" TYPE="foreign" FIELDS="referential_id" REFTABLE="local_qualiscope_referentials" REFFIELDS="id" COMMENT="FK to referentials."/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_qualiscope_results" COMMENT="Analysis results per course per campaign.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key."/>
        <FIELD NAME="campaign_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to campaigns."/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course ID."/>
        <FIELD NAME="check_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to checks."/>
        <FIELD NAME="indicator_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to indicators."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="missing" SEQUENCE="false" COMMENT="Result status."/>
        <FIELD NAME="ratio" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Partial compliance ratio (0-1)."/>
        <FIELD NAME="detail" TYPE="text" NOTNULL="false"  SEQUENCE="false" COMMENT="Detail of the result."/>
        <FIELD NAME="evidence_count" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Number of evidences."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time created."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time modified."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key."/>
        <KEY NAME="campaign" TYPE="foreign" FIELDS="campaign_id" REFTABLE="local_qualiscope_campaigns" REFFIELDS="id" COMMENT="FK to campaigns."/>
        <KEY NAME="check" TYPE="foreign" FIELDS="check_id" REFTABLE="local_qualiscope_checks" REFFIELDS="id" COMMENT="FK to checks."/>
        <KEY NAME="indicator" TYPE="foreign" FIELDS="indicator_id" REFTABLE="local_qualiscope_indicators" REFFIELDS="id" COMMENT="FK to indicators."/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="campaign_course" UNIQUE="false" FIELDS="campaign_id, courseid" COMMENT="Campaign + course index."/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_qualiscope_evidences" COMMENT="Evidence items for results.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key."/>
        <FIELD NAME="result_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to results."/>
        <FIELD NAME="type" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="moodle" SEQUENCE="false" COMMENT="Evidence type."/>
        <FIELD NAME="source" TYPE="char" LENGTH="255" NOTNULL="false"  SEQUENCE="false" COMMENT="Evidence source."/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Evidence title."/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"  SEQUENCE="false" COMMENT="Evidence description."/>
        <FIELD NAME="filepath" TYPE="char" LENGTH="255" NOTNULL="false"  SEQUENCE="false" COMMENT="File path."/>
        <FIELD NAME="filename" TYPE="char" LENGTH="255" NOTNULL="false"  SEQUENCE="false" COMMENT="File name."/>
<FIELD NAME="externalurl" TYPE="char" LENGTH="1333" NOTNULL="false" SEQUENCE="false" COMMENT="External URL."/>
        <FIELD NAME="annotation" TYPE="text" NOTNULL="false"  SEQUENCE="false" COMMENT="User annotation."/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Uploader user ID."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time created."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time modified."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key."/>
        <KEY NAME="result" TYPE="foreign" FIELDS="result_id" REFTABLE="local_qualiscope_results" REFFIELDS="id" COMMENT="FK to results."/>
      </KEYS>
    </TABLE>

    <TABLE NAME="local_qualiscope_actions" COMMENT="Corrective actions.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key."/>
        <FIELD NAME="result_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to results."/>
        <FIELD NAME="campaign_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to campaigns."/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course ID."/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Action title."/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"  SEQUENCE="false" COMMENT="Action description."/>
        <FIELD NAME="responsible" TYPE="char" LENGTH="255" NOTNULL="false"  SEQUENCE="false" COMMENT="Responsible person."/>
        <FIELD NAME="duedate" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Due date."/>
        <FIELD NAME="priority" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="medium" SEQUENCE="false" COMMENT="Priority level."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="todo" SEQUENCE="false" COMMENT="Action status."/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Creator user ID."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time created."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Time modified."/>
        <FIELD NAME="timeclosed" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Time closed."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key."/>
        <KEY NAME="result" TYPE="foreign" FIELDS="result_id" REFTABLE="local_qualiscope_results" REFFIELDS="id" COMMENT="FK to results."/>
        <KEY NAME="campaign" TYPE="foreign" FIELDS="campaign_id" REFTABLE="local_qualiscope_campaigns" REFFIELDS="id" COMMENT="FK to campaigns."/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="campaign_status" UNIQUE="false" FIELDS="campaign_id, status" COMMENT="Campaign + status index."/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_qualiscope_auditedcourses" COMMENT="Distinct courses audited on this site (freemium quota tracking).">
      <FIELDS>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course id (unique)."/>
        <FIELD NAME="timeaudited" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="First time this course was audited."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="courseid" COMMENT="Primary key."/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>