{{!
    @template local_qualiscope/action

    Actions list and creation form for a course.

    Example context (json):
    {
        "actions": [
            {
                "title": "Add a course summary",
                "responsible": "Jane Doe",
                "duedateformatted": "30/09/2026",
                "priorityhigh": true,
                "prioritylabel": "High",
                "statustodo": true,
                "statuslabel": "To do",
                "editurl": "action_edit.php?id=1"
            }
        ],
        "saveactionurl": "action_save.php",
        "sesskey": "abc123",
        "resultid": 2,
        "campaignid": 1,
        "courseid": 4
    }
}}
<div class="qualiscope-action container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h3>{{#str}} action_title, local_qualiscope {{/str}}</h3>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <button class="btn btn-primary" data-toggle="qualiscope-action-form">{{#str}} action_create, local_qualiscope {{/str}}</button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>{{#str}} action_name, local_qualiscope {{/str}}</th>
                        <th>{{#str}} action_responsible, local_qualiscope {{/str}}</th>
                        <th>{{#str}} action_duedate, local_qualiscope {{/str}}</th>
                        <th>{{#str}} action_priority, local_qualiscope {{/str}}</th>
                        <th>{{#str}} action_status, local_qualiscope {{/str}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#actions}}
                    <tr>
                        <td>{{title}}</td>
                        <td>{{responsible}}</td>
                        <td>{{duedateformatted}}</td>
                        <td>
                            <span class="badge
                                {{#priorityhigh}}bg-danger{{/priorityhigh}}
                                {{#prioritymedium}}bg-warning text-dark{{/prioritymedium}}
                                {{#prioritylow}}bg-success{{/prioritylow}}
                            ">{{prioritylabel}}</span>
                        </td>
                        <td>
                            <span class="badge
                                {{#statustodo}}bg-secondary{{/statustodo}}
                                {{#statusinprogress}}bg-primary{{/statusinprogress}}
                                {{#statusproved}}bg-info{{/statusproved}}
                                {{#statusverified}}bg-warning text-dark{{/statusverified}}
                                {{#statusclosed}}bg-success{{/statusclosed}}
                            ">{{statuslabel}}</span>
                        </td>
                        <td>
                            <a href="{{{editurl}}}" class="btn btn-sm btn-outline-secondary">✏</a>
                        </td>
                    </tr>
                    {{/actions}}

                    {{^actions}}
                    <tr>
                        <td colspan="6" class="text-center text-muted">{{#str}} no_results, local_qualiscope {{/str}}</td>
                    </tr>
                    {{/actions}}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4" id="action-form" style="display:none;">
        <div class="card-header"><h5 class="mb-0">{{#str}} action_create, local_qualiscope {{/str}}</h5></div>
        <div class="card-body">
            <form method="post" action="{{saveactionurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="resultid" value="{{resultid}}">
                <input type="hidden" name="campaignid" value="{{campaignid}}">
                <input type="hidden" name="courseid" value="{{courseid}}">

                <div class="mb-3">
                    <label class="form-label">{{#str}} action_name, local_qualiscope {{/str}}</label>
                    <input type="text" class="form-control" name="title" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{#str}} action_responsible, local_qualiscope {{/str}}</label>
                    <input type="text" class="form-control" name="responsible">
                </div>

                <div class="mb-3">
                    <label class="form-label">{{#str}} action_duedate, local_qualiscope {{/str}}</label>
                    <input type="date" class="form-control" name="duedate">
                </div>

                <div class="mb-3">
                    <label class="form-label">{{#str}} action_priority, local_qualiscope {{/str}}</label>
                    <select class="form-select" name="priority">
                        <option value="high">{{#str}} action_priority_high, local_qualiscope {{/str}}</option>
                        <option value="medium" selected>{{#str}} action_priority_medium, local_qualiscope {{/str}}</option>
                        <option value="low">{{#str}} action_priority_low, local_qualiscope {{/str}}</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">{{#str}} action_submit, local_qualiscope {{/str}}</button>
            </form>
        </div>
    </div>
</div>
