{{!
    @template local_qualiscope/campaign

    Campaigns list and creation form.

    The creation form is a moodleform rendered by campaigns.php, so the scope
    pickers, their classes and the course autocomplete come from that form.

    Example context (json):
    {
        "compareurl": "compare.php",
        "campaignform": "<form>...</form>",
        "campaigns": [
            {
                "viewurl": "campaign_view.php?id=1",
                "name": "Completed audit",
                "referential": "Qualiopi",
                "scopelabel": "All courses",
                "course_count": 5,
                "has_coverage": true,
                "coverage_class": "bg-success",
                "avg_coverage": "82%",
                "dateformatted": "24/09/2026",
                "timecompleted": 1,
                "rerunurl": "campaign_rerun.php?id=1"
            },
            {
                "viewurl": "campaign_view.php?id=2",
                "name": "Running audit",
                "referential": "Qualiopi",
                "scopelabel": "Category",
                "course_count": 3,
                "has_coverage": false,
                "coverage_class": "bg-secondary",
                "avg_coverage": "0%",
                "dateformatted": "24/09/2026",
                "timecompleted": 0,
                "runurl": "campaign_run.php?id=2"
            }
        ]
    }
}}
<div class="qualiscope-campaign container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h3>{{#str}} campaign_title, local_qualiscope {{/str}}</h3>
            <div>
                <a href="{{{compareurl}}}" class="btn btn-outline-primary me-2">
                    <i class="fa fa-exchange me-1" aria-hidden="true"></i> {{#str}} campaign_compare, local_qualiscope {{/str}}
                </a>
                <button class="btn btn-primary" data-toggle="qualiscope-campaign-form">{{#str}} campaign_create, local_qualiscope {{/str}}</button>
            </div>
        </div>
    </div>

    <div class="card mb-4" id="campaign-form" style="display:none;">
        <div class="card-header"><h5 class="mb-0">{{#str}} campaign_create, local_qualiscope {{/str}}</h5></div>
        <div class="card-body">
            {{{campaignform}}}
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>{{#str}} campaign_name, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_referential, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_scope, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_courses_analysed, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_avg_coverage, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_date, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_status, local_qualiscope {{/str}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#campaigns}}
                    <tr>
                        <td><a href="{{{viewurl}}}">{{name}}</a></td>
                        <td>{{referential}}</td>
                        <td>{{scopelabel}}</td>
                        <td>{{course_count}}</td>
                        <td>
                            {{#has_coverage}}
                            <span class="badge {{coverage_class}}">{{avg_coverage}}</span>
                            {{/has_coverage}}
                            {{^has_coverage}}
                            <span class="text-muted">—</span>
                            {{/has_coverage}}
                        </td>
                        <td>{{dateformatted}}</td>
                        <td>
                            <span class="badge {{#timecompleted}}bg-success{{/timecompleted}}{{^timecompleted}}bg-primary{{/timecompleted}}">
                                {{#timecompleted}}
                                {{#str}} campaign_status_completed, local_qualiscope {{/str}}
                                {{/timecompleted}}
                                {{^timecompleted}}
                                {{#str}} campaign_status_running, local_qualiscope {{/str}}
                                {{/timecompleted}}
                            </span>
                        </td>
                        <td>
                            {{^timecompleted}}
                            <a href="{{{runurl}}}" class="btn btn-sm btn-primary">{{#str}} campaign_run, local_qualiscope {{/str}}</a>
                            {{/timecompleted}}
                            {{#timecompleted}}
                            <a href="{{{rerunurl}}}" class="btn btn-sm btn-outline-primary">{{#str}} campaign_rerun, local_qualiscope {{/str}}</a>
                            {{/timecompleted}}
                        </td>
                    </tr>
                    {{/campaigns}}

                    {{^campaigns}}
                    <tr>
                        <td colspan="8" class="text-center text-muted">{{#str}} no_results, local_qualiscope {{/str}}</td>
                    </tr>
                    {{/campaigns}}
                </tbody>
            </table>
        </div>
    </div>
</div>
