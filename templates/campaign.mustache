{{!
    @template local_qualiscope/campaign

    Campaigns list and creation form.

    Example context (json):
    {
        "compareurl": "compare.php",
        "savecampaignurl": "campaign_save.php",
        "sesskey": "abc123",
        "referentials": [
            {"id": 1, "name": "Qualiopi", "version": "1.0"}
        ],
        "categories": [
            {"id": 2, "name": "Category name"}
        ],
        "courses": [
            {"id": 4, "fullname": "Course full name"}
        ],
        "campaigns": [
            {
                "viewurl": "campaign_view.php?id=1",
                "name": "Completed audit",
                "referential": "Qualiopi",
                "scopelabel": "All courses",
                "course_count": 5,
                "has_coverage": true,
                "coverage_class": "bg-success",
                "avg_coverage": "82%",
                "dateformatted": "24/09/2026",
                "timecompleted": 1,
                "rerunurl": "campaign_rerun.php?id=1"
            },
            {
                "viewurl": "campaign_view.php?id=2",
                "name": "Running audit",
                "referential": "Qualiopi",
                "scopelabel": "Category",
                "course_count": 3,
                "has_coverage": false,
                "coverage_class": "bg-secondary",
                "avg_coverage": "0%",
                "dateformatted": "24/09/2026",
                "timecompleted": 0,
                "runurl": "campaign_run.php?id=2"
            }
        ]
    }
}}
<div class="qualiscope-campaign container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h3>{{#str}} campaign_title, local_qualiscope {{/str}}</h3>
            <div>
                <a href="{{{compareurl}}}" class="btn btn-outline-primary me-2">
                    <i class="fa fa-exchange me-1" aria-hidden="true"></i> {{#str}} campaign_compare, local_qualiscope {{/str}}
                </a>
                <button class="btn btn-primary" data-toggle="qualiscope-campaign-form">{{#str}} campaign_create, local_qualiscope {{/str}}</button>
            </div>
        </div>
    </div>

    <div class="card mb-4" id="campaign-form" style="display:none;">
        <div class="card-header"><h5 class="mb-0">{{#str}} campaign_create, local_qualiscope {{/str}}</h5></div>
        <div class="card-body">
            <form method="post" action="{{savecampaignurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">

                <div class="mb-3">
                    <label class="form-label">{{#str}} campaign_name, local_qualiscope {{/str}}</label>
                    <input type="text" class="form-control" name="name" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{#str}} campaign_referential, local_qualiscope {{/str}}</label>
                    <select class="form-select" name="referential_id">
                        {{#referentials}}
                        <option value="{{id}}">{{name}} {{version}}</option>
                        {{/referentials}}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{#str}} campaign_scope, local_qualiscope {{/str}}</label>
                    <select class="form-select" name="scope" id="scope-select">
                        <option value="all">{{#str}} campaign_scope_all, local_qualiscope {{/str}}</option>
                        <option value="category">{{#str}} campaign_scope_category, local_qualiscope {{/str}}</option>
                        <option value="selected">{{#str}} campaign_scope_selected, local_qualiscope {{/str}}</option>
                    </select>
                </div>

                <div class="mb-3" id="scope-categories" style="display:none;">
                    <label class="form-label">{{#str}} campaign_scope_category, local_qualiscope {{/str}}</label>
                    <select class="form-select" name="scopeids[]" multiple size="5">
                        {{#categories}}
                        <option value="{{id}}">{{name}}</option>
                        {{/categories}}
                    </select>
                </div>

                <div class="mb-3" id="scope-courses" style="display:none;">
                    <label class="form-label">{{#str}} campaign_scope_selected, local_qualiscope {{/str}}</label>
                    <select class="form-select" name="scopeids[]" multiple size="5">
                        {{#courses}}
                        <option value="{{id}}">{{fullname}}</option>
                        {{/courses}}
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">{{#str}} campaign_submit, local_qualiscope {{/str}}</button>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>{{#str}} campaign_name, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_referential, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_scope, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_courses_analysed, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_avg_coverage, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_date, local_qualiscope {{/str}}</th>
                        <th>{{#str}} campaign_status, local_qualiscope {{/str}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#campaigns}}
                    <tr>
                        <td><a href="{{{viewurl}}}">{{name}}</a></td>
                        <td>{{referential}}</td>
                        <td>{{scopelabel}}</td>
                        <td>{{course_count}}</td>
                        <td>
                            {{#has_coverage}}
                            <span class="badge {{coverage_class}}">{{avg_coverage}}</span>
                            {{/has_coverage}}
                            {{^has_coverage}}
                            <span class="text-muted">—</span>
                            {{/has_coverage}}
                        </td>
                        <td>{{dateformatted}}</td>
                        <td>
                            <span class="badge {{#timecompleted}}bg-success{{/timecompleted}}{{^timecompleted}}bg-primary{{/timecompleted}}">
                                {{#timecompleted}}
                                {{#str}} campaign_status_completed, local_qualiscope {{/str}}
                                {{/timecompleted}}
                                {{^timecompleted}}
                                {{#str}} campaign_status_running, local_qualiscope {{/str}}
                                {{/timecompleted}}
                            </span>
                        </td>
                        <td>
                            {{^timecompleted}}
                            <a href="{{{runurl}}}" class="btn btn-sm btn-primary">{{#str}} campaign_run, local_qualiscope {{/str}}</a>
                            {{/timecompleted}}
                            {{#timecompleted}}
                            <a href="{{{rerunurl}}}" class="btn btn-sm btn-outline-primary">{{#str}} campaign_rerun, local_qualiscope {{/str}}</a>
                            {{/timecompleted}}
                        </td>
                    </tr>
                    {{/campaigns}}

                    {{^campaigns}}
                    <tr>
                        <td colspan="8" class="text-center text-muted">{{#str}} no_results, local_qualiscope {{/str}}</td>
                    </tr>
                    {{/campaigns}}
                </tbody>
            </table>
        </div>
    </div>
</div>
