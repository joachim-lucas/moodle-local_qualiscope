{{!
    @template local_qualiscope/campaign_run

    Progress panel shown while a campaign is being analysed course by course.

    The element ids are part of the contract with the local_qualiscope/campaign_run module.

    Example context (json):
    {
        "campaignname": "Spring audit 2026",
        "coursecount": 12,
        "progresslabel": "Courses analysed",
        "waitlabel": "Please wait while audited courses are being processed...",
        "runningtitle": "Campaign analysis in progress"
    }
}}
<div class="qualiscope-run-progress container py-5">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 700px;">
        <div class="card-body p-4 text-center">
            <div class="mb-3">
                <span class="spinner-border text-primary" role="status" id="runSpinner"
                    style="width: 3rem; height: 3rem;"></span>
            </div>
            <h4 class="mb-2" id="runTitle">{{runningtitle}}</h4>
            <p class="text-muted mb-4">{{campaignname}} &bull; <strong>{{coursecount}}</strong> {{progresslabel}}</p>

            <div class="progress mb-3" style="height: 26px; border-radius: 13px;">
                <div id="runProgressBar"
                    class="progress-bar progress-bar-striped progress-bar-animated bg-primary font-weight-bold"
                    role="progressbar" style="width: 0%; font-size: 13px;">0%</div>
            </div>

            <div id="runProgressText" class="text-muted small mb-3">{{waitlabel}}</div>

            <div id="runCurrentCourse" class="alert alert-light border py-2 small text-truncate">...</div>
        </div>
    </div>
</div>
