{{!
    @template local_qualiscope/compare_campaigns

    Comparison of two campaigns across criteria, indicators and courses.

    Example context (json):
    {
        "backurl": "campaigns.php",
        "campaignsoptionsa": [
            {"id": 1, "name": "Campaign A", "selected": true}
        ],
        "campaignsoptionsb": [
            {"id": 2, "name": "Campaign B", "selected": true}
        ],
        "hascomparison": false
    }
}}
<div class="qualiscope-compare container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-1">{{#str}} campaign_compare_title, local_qualiscope {{/str}}</h3>
                <p class="text-muted mb-0">{{#str}} campaign_compare_desc, local_qualiscope {{/str}}</p>
            </div>
            <div>
                <a href="{{{backurl}}}" class="btn btn-outline-secondary">{{#str}} nav_campaigns, local_qualiscope {{/str}}</a>
            </div>
        </div>
    </div>

    <!-- Campaign Selection Form -->
    <div class="card mb-4 border shadow-none">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-bold">{{#str}} campaign_base, local_qualiscope {{/str}}</label>
                    <select name="id_a" class="form-select" required>
                        <option value="">— {{#str}} choose, core {{/str}} —</option>
                        {{#campaignsoptionsa}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/campaignsoptionsa}}
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-bold">{{#str}} campaign_target, local_qualiscope {{/str}}</label>
                    <select name="id_b" class="form-select" required>
                        <option value="">— {{#str}} choose, core {{/str}} —</option>
                        {{#campaignsoptionsb}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/campaignsoptionsb}}
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-exchange me-1" aria-hidden="true"></i> {{#str}} campaign_compare_btn, local_qualiscope {{/str}}
                    </button>
                </div>
            </form>
        </div>
    </div>

    {{#comparisonerror}}
    <div class="alert alert-warning mb-4">
        {{comparisonerror}}
    </div>
    {{/comparisonerror}}

    {{#hascomparison}}
    <!-- Comparison Overview Cards -->
    <div class="row mb-4 align-items-stretch">
        <div class="col-md-5">
            <div class="card h-100 shadow-none border bg-light">
                <div class="card-body">
                    <span class="badge bg-secondary mb-2">{{#str}} campaign_base, local_qualiscope {{/str}}</span>
                    <h5 class="card-title mb-1">{{campaigndata_a.campaign.name}}</h5>
                    <div class="text-muted small mb-3">{{campaigndata_a.referential}} • {{campaigndata_a.dateformatted}}</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="display-5 fw-bold text-primary">{{campaigndata_a.globalpercentage}}%</div>
                            <small class="text-muted">{{#str}} campaign_compliance_rate, local_qualiscope {{/str}}</small>
                        </div>
                        <div class="text-end">
                            <div class="fs-4 fw-bold">{{campaigndata_a.coursescount}}</div>
                            <small class="text-muted">{{#str}} campaign_courses_analysed, local_qualiscope {{/str}}</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-2 d-flex flex-column align-items-center justify-content-center text-center py-3">
            <div class="display-6 fw-bold {{deltaglobalclass}} mb-1">{{deltaglobal}}</div>
            <span class="badge {{#has_global_progression}}bg-success{{/has_global_progression}}{{#has_global_regression}}bg-danger{{/has_global_regression}}{{^has_global_progression}}{{^has_global_regression}}bg-secondary{{/has_global_regression}}{{/has_global_progression}}">
                {{#str}} campaign_progression, local_qualiscope {{/str}}
            </span>
        </div>

        <div class="col-md-5">
            <div class="card h-100 shadow-none border bg-light">
                <div class="card-body">
                    <span class="badge bg-primary mb-2">{{#str}} campaign_target, local_qualiscope {{/str}}</span>
                    <h5 class="card-title mb-1">{{campaigndata_b.campaign.name}}</h5>
                    <div class="text-muted small mb-3">{{campaigndata_b.referential}} • {{campaigndata_b.dateformatted}}</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="display-5 fw-bold text-primary">{{campaigndata_b.globalpercentage}}%</div>
                            <small class="text-muted">{{#str}} campaign_compliance_rate, local_qualiscope {{/str}}</small>
                        </div>
                        <div class="text-end">
                            <div class="fs-4 fw-bold">{{campaigndata_b.coursescount}}</div>
                            <small class="text-muted">{{#str}} campaign_courses_analysed, local_qualiscope {{/str}}</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Comparison Tabs -->
    <ul class="nav nav-tabs mb-4" id="compareTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="criteria-tab" data-bs-toggle="tab" data-bs-target="#criteria-content" type="button" role="tab" aria-controls="criteria-content" aria-selected="true">
                <i class="fa fa-list-alt me-1" aria-hidden="true"></i> {{#str}} campaign_compare_criteria, local_qualiscope {{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="indicators-tab" data-bs-toggle="tab" data-bs-target="#indicators-content" type="button" role="tab" aria-controls="indicators-content" aria-selected="false">
                <i class="fa fa-bar-chart me-1" aria-hidden="true"></i> {{#str}} campaign_compare_indicators, local_qualiscope {{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="courses-tab" data-bs-toggle="tab" data-bs-target="#courses-content" type="button" role="tab" aria-controls="courses-content" aria-selected="false">
                <i class="fa fa-graduation-cap me-1" aria-hidden="true"></i> {{#str}} campaign_compare_courses, local_qualiscope {{/str}}
            </button>
        </li>
    </ul>

    <div class="tab-content" id="compareTabContent">
        <!-- Criteria comparison -->
        <div class="tab-pane fade show active" id="criteria-content" role="tabpanel" aria-labelledby="criteria-tab">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 10%;">{{#str}} campaign_criterion, local_qualiscope {{/str}}</th>
                            <th style="width: 50%;">{{#str}} description, core {{/str}}</th>
                            <th class="text-center" style="width: 13%;">{{campaigndata_a.campaign.name}} (A)</th>
                            <th class="text-center" style="width: 13%;">{{campaigndata_b.campaign.name}} (B)</th>
                            <th class="text-center" style="width: 14%;">{{#str}} campaign_progression, local_qualiscope {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#comparedcriteria}}
                        <tr>
                            <td><span class="badge bg-dark">C{{number}}</span></td>
                            <td><strong>{{title}}</strong></td>
                            <td class="text-center">{{score_a}}</td>
                            <td class="text-center fw-bold">{{score_b}}</td>
                            <td class="text-center fw-bold {{deltaclass}}">
                                {{#has_progression}}<i class="fa fa-arrow-up text-success me-1"></i>{{/has_progression}}
                                {{#has_regression}}<i class="fa fa-arrow-down text-danger me-1"></i>{{/has_regression}}
                                {{delta}}
                            </td>
                        </tr>
                        {{/comparedcriteria}}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Indicators comparison -->
        <div class="tab-pane fade" id="indicators-content" role="tabpanel" aria-labelledby="indicators-tab">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 10%;">{{#str}} campaign_indicator, local_qualiscope {{/str}}</th>
                            <th style="width: 50%;">{{#str}} description, core {{/str}}</th>
                            <th class="text-center" style="width: 13%;">{{campaigndata_a.campaign.name}} (A)</th>
                            <th class="text-center" style="width: 13%;">{{campaigndata_b.campaign.name}} (B)</th>
                            <th class="text-center" style="width: 14%;">{{#str}} campaign_progression, local_qualiscope {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#comparedindicators}}
                        <tr>
                            <td><span class="badge bg-secondary">I{{number}}</span></td>
                            <td>{{title}}</td>
                            <td class="text-center">{{score_a}}</td>
                            <td class="text-center fw-bold">{{score_b}}</td>
                            <td class="text-center fw-bold {{deltaclass}}">
                                {{#has_progression}}<i class="fa fa-arrow-up text-success me-1"></i>{{/has_progression}}
                                {{#has_regression}}<i class="fa fa-arrow-down text-danger me-1"></i>{{/has_regression}}
                                {{delta}}
                            </td>
                        </tr>
                        {{/comparedindicators}}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Courses comparison -->
        <div class="tab-pane fade" id="courses-content" role="tabpanel" aria-labelledby="courses-tab">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60%;">{{#str}} campaign_course, local_qualiscope {{/str}}</th>
                            <th class="text-center" style="width: 13%;">{{campaigndata_a.campaign.name}} (A)</th>
                            <th class="text-center" style="width: 13%;">{{campaigndata_b.campaign.name}} (B)</th>
                            <th class="text-center" style="width: 14%;">{{#str}} campaign_progression, local_qualiscope {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#comparedcourses}}
                        <tr>
                            <td><strong>{{coursename}}</strong></td>
                            <td class="text-center">{{score_a}}</td>
                            <td class="text-center fw-bold">{{score_b}}</td>
                            <td class="text-center fw-bold {{deltaclass}}">
                                {{#has_progression}}<i class="fa fa-arrow-up text-success me-1"></i>{{/has_progression}}
                                {{#has_regression}}<i class="fa fa-arrow-down text-danger me-1"></i>{{/has_regression}}
                                {{delta}}
                            </td>
                        </tr>
                        {{/comparedcourses}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{/hascomparison}}

    {{^hascomparison}}
    {{^comparisonerror}}
    <div class="alert alert-info">
        <i class="fa fa-info-circle me-1" aria-hidden="true"></i> {{#str}} campaign_select_to_compare, local_qualiscope {{/str}}
    </div>
    {{/comparisonerror}}
    {{/hascomparison}}
</div>
