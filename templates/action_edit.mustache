{{!
    @template local_qualiscope/action_edit

    Edit form of a single corrective action.

    Example context (json):
    {
        "sesskey": "abc123",
        "return": "campaign",
        "title": "Add a course summary",
        "responsible": "Jane Doe",
        "duedate": "30/09/2026",
        "priorities": [
            {"value": "high", "label": "High", "selected": false},
            {"value": "medium", "label": "Medium", "selected": true}
        ],
        "statuses": [
            {"value": "todo", "label": "To do", "selected": true},
            {"value": "inprogress", "label": "In progress", "selected": false}
        ],
        "title_label": "Action title",
        "responsible_label": "Responsible",
        "duedate_label": "Due date",
        "priority_label": "Priority",
        "status_label": "Status",
        "submitlabel": "Save"
    }
}}
<form method="post">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="return" value="{{return}}">

    <div class="mb-3">
        <label class="form-label" for="qualiscope-action-title">{{title_label}}</label>
        <input type="text" class="form-control" id="qualiscope-action-title" name="title" value="{{title}}" required>
    </div>

    <div class="mb-3">
        <label class="form-label" for="qualiscope-action-responsible">{{responsible_label}}</label>
        <input type="text" class="form-control" id="qualiscope-action-responsible" name="responsible"
            value="{{responsible}}">
    </div>

    <div class="mb-3">
        <label class="form-label" for="qualiscope-action-duedate">{{duedate_label}}</label>
        <input type="date" class="form-control" id="qualiscope-action-duedate" name="duedate" value="{{duedate}}">
    </div>

    <div class="mb-3">
        <label class="form-label" for="qualiscope-action-priority">{{priority_label}}</label>
        <select class="form-select" id="qualiscope-action-priority" name="priority">
            {{#priorities}}
            <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
            {{/priorities}}
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label" for="qualiscope-action-status">{{status_label}}</label>
        <select class="form-select" id="qualiscope-action-status" name="status">
            {{#statuses}}
            <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
            {{/statuses}}
        </select>
    </div>

    <button type="submit" class="btn btn-primary">{{submitlabel}}</button>
</form>
