<div class="qualiscope-campaign-dashboard container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-1">{{campaignname}}</h3>
                <span class="badge {{#completed}}bg-success{{/completed}}{{^completed}}bg-primary{{/completed}}">
                    {{#completed}}
                    {{#str}} campaign_status_completed, local_qualiscope {{/str}}
                    {{/completed}}
                    {{^completed}}
                    {{#str}} campaign_status_running, local_qualiscope {{/str}}
                    {{/completed}}
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="{{{compareurl}}}" class="btn btn-outline-info">
                    <i class="fa fa-exchange me-1" aria-hidden="true"></i> {{#str}} campaign_compare, local_qualiscope {{/str}}
                </a>
                {{#hasresults}}
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="campaignExportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-download me-1" aria-hidden="true"></i> {{#str}} campaign_export_report, local_qualiscope {{/str}}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="campaignExportDropdown">
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="{{{exportpdfurl}}}">
                                <i class="fa fa-file-pdf-o text-danger" aria-hidden="true"></i> {{#str}} campaign_export_pdf, local_qualiscope {{/str}}
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="{{{exportxlsxurl}}}">
                                <i class="fa fa-file-excel-o text-success" aria-hidden="true"></i> {{#str}} campaign_export_xlsx, local_qualiscope {{/str}}
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="{{{exportcsvurl}}}">
                                <i class="fa fa-file-text-o text-info" aria-hidden="true"></i> {{#str}} campaign_export_csv, local_qualiscope {{/str}}
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="{{{printreporturl}}}" target="_blank">
                                <i class="fa fa-print text-secondary" aria-hidden="true"></i> {{#str}} campaign_print_report, local_qualiscope {{/str}}
                            </a>
                        </li>
                    </ul>
                </div>
                {{/hasresults}}
                {{^completed}}
                <a href="{{{runurl}}}" class="btn btn-primary">{{#str}} campaign_run, local_qualiscope {{/str}}</a>
                {{/completed}}
                {{#completed}}
                <a href="{{{rerunurl}}}" class="btn btn-outline-primary">{{#str}} campaign_rerun, local_qualiscope {{/str}}</a>
                {{/completed}}
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 text-muted">
            <strong>{{#str}} campaign_referential, local_qualiscope {{/str}} :</strong> {{referential}} |
            <strong>{{#str}} campaign_scope, local_qualiscope {{/str}} :</strong> {{scopelabel}} |
            <strong>{{#str}} campaign_date, local_qualiscope {{/str}} :</strong> {{dateformatted}}
        </div>
    </div>

    <div class="row mb-4">
        {{#summaryitems}}
        <div class="col-md-2 col-sm-6 mb-3">
            <div class="card shadow-none {{bgclass}} h-100">
                <div class="card-body p-3">
                    <div class="text-muted small mb-1">{{label}}</div>
                    <div class="fs-4 fw-bold lh-1">{{value}}</div>
                </div>
            </div>
        </div>
        {{/summaryitems}}
    </div>

    {{#hasresults}}
    <ul class="nav nav-tabs mb-4" id="campaignTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="courses-tab" data-bs-toggle="tab" data-bs-target="#courses-content" type="button" role="tab" aria-controls="courses-content" aria-selected="true">
                <i class="fa fa-graduation-cap me-1" aria-hidden="true"></i> {{#str}} campaign_tab_courses, local_qualiscope {{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="macro-tab" data-bs-toggle="tab" data-bs-target="#macro-content" type="button" role="tab" aria-controls="macro-content" aria-selected="false">
                <i class="fa fa-bar-chart me-1" aria-hidden="true"></i> {{#str}} campaign_tab_macro, local_qualiscope {{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="weakpoints-tab" data-bs-toggle="tab" data-bs-target="#weakpoints-content" type="button" role="tab" aria-controls="weakpoints-content" aria-selected="false">
                <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"></i> {{#str}} campaign_tab_weakpoints, local_qualiscope {{/str}}
                {{#hasweakpoints}}<span class="badge bg-danger ms-1">{{weakpoints.length}}</span>{{/hasweakpoints}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="capa-tab" data-bs-toggle="tab" data-bs-target="#capa-content" type="button" role="tab" aria-controls="capa-content" aria-selected="false">
                <i class="fa fa-tasks me-1" aria-hidden="true"></i> {{#str}} campaign_tab_actions, local_qualiscope {{/str}}
                <span class="badge bg-secondary ms-1">{{actionstotal}}</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="campaignTabContent">
        <div class="tab-pane fade show active" id="courses-content" role="tabpanel" aria-labelledby="courses-tab">
            <!-- Filter & Search Toolbar -->
            <div class="row g-2 mb-3 align-items-center bg-light p-2 rounded border">
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-search"></i></span>
                        <input type="text" id="courseFilterSearch" class="form-control" placeholder="{{#str}} campaign_search_courses, local_qualiscope {{/str}}">
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="courseFilterCoverage" class="form-select form-select-sm">
                        <option value="all">{{#str}} campaign_filter_all_scores, local_qualiscope {{/str}}</option>
                        <option value="gte75">{{#str}} campaign_filter_gte75, local_qualiscope {{/str}}</option>
                        <option value="50to75">{{#str}} campaign_filter_50to75, local_qualiscope {{/str}}</option>
                        <option value="lt50">{{#str}} campaign_filter_lt50, local_qualiscope {{/str}}</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="courseFilterStatus" class="form-select form-select-sm">
                        <option value="all">{{#str}} campaign_filter_all_status, local_qualiscope {{/str}}</option>
                        <option value="missing">{{#str}} campaign_filter_has_missing, local_qualiscope {{/str}}</option>
                        <option value="verify">{{#str}} campaign_filter_has_verify, local_qualiscope {{/str}}</option>
                        <option value="perfect">{{#str}} campaign_filter_perfect, local_qualiscope {{/str}}</option>
                    </select>
                </div>
                <div class="col-md-2 text-md-end text-muted small">
                    <span id="courseFilterCount" class="fw-bold text-dark">{{courses.length}}</span> / {{courses.length}} {{#str}} courses, core {{/str}}
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>{{#str}} campaign_course, local_qualiscope {{/str}}</th>
                                <th>{{#str}} dashboard_score, local_qualiscope {{/str}}</th>
                                <th class="text-center">✓</th>
                                <th class="text-center">⚠</th>
                                <th class="text-center">✗</th>
                                <th class="text-center">—</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#courses}}
                            <tr class="qualiscope-course-row"
                                data-coursename="{{coursename}}"
                                data-percentage="{{percentage}}"
                                data-missing="{{missing}}"
                                data-verify="{{verify}}"
                                data-detected="{{detected}}">
                                <td><strong>{{coursename}}</strong></td>
                                <td><span class="badge {{percentageclass}}">{{percentage}}%</span></td>
                                <td class="text-center">{{detected}}</td>
                                <td class="text-center">{{verify}}</td>
                                <td class="text-center">{{missing}}</td>
                                <td class="text-center">{{na}}</td>
                                <td class="text-end"><a href="{{{viewurl}}}" class="btn btn-sm btn-outline-primary">{{#str}} view, core {{/str}}</a></td>
                            </tr>
                            {{/courses}}
                        </tbody>
                    </table>
                    <div id="courseFilterNoResults" class="alert alert-warning text-center" style="display:none;">
                        {{#str}} campaign_no_matching_courses, local_qualiscope {{/str}}
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="macro-content" role="tabpanel" aria-labelledby="macro-tab">
            <div class="mb-3">
                <h5 class="mb-1">{{#str}} campaign_macro_title, local_qualiscope {{/str}}</h5>
                <p class="text-muted small mb-0">{{#str}} campaign_macro_desc, local_qualiscope {{/str}}</p>
            </div>
            {{#criteria}}
            <div class="card mb-3 shadow-none border">
                <div class="card-header d-flex justify-content-between align-items-center bg-light">
                    <div>
                        <span class="badge bg-dark me-2">C{{number}}</span>
                        <strong>{{title}}</strong>
                    </div>
                    <div>
                        {{#manualonly}}
                        <span class="badge bg-secondary">{{#str}} dashboard_manual_only, local_qualiscope {{/str}}</span>
                        {{/manualonly}}
                        {{^manualonly}}
                        <span class="badge {{percentageclass}}">{{percentage}}% {{#str}} campaign_compliance_rate, local_qualiscope {{/str}}</span>
                        {{/manualonly}}
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 10%;">{{#str}} campaign_indicator, local_qualiscope {{/str}}</th>
                                    <th style="width: 45%;">{{#str}} description, core {{/str}}</th>
                                    <th style="width: 25%;">{{#str}} campaign_compliance_rate, local_qualiscope {{/str}}</th>
                                    <th class="text-center" style="width: 5%;">✓</th>
                                    <th class="text-center" style="width: 5%;">⚠</th>
                                    <th class="text-center" style="width: 5%;">✗</th>
                                    <th class="text-center" style="width: 5%;">—</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#indicators}}
                                <tr>
                                    <td><span class="badge bg-secondary">I{{number}}</span></td>
                                    <td>{{title}}</td>
                                    <td>
                                        {{#haspercentage}}
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 10px;">
                                                <div class="progress-bar {{percentageclass}}" style="width: {{percentage}}%;"></div>
                                            </div>
                                            <span class="fw-bold small">{{percentage}}%</span>
                                        </div>
                                        {{/haspercentage}}
                                        {{^haspercentage}}
                                        <span class="badge bg-secondary">{{#str}} dashboard_manual_only, local_qualiscope {{/str}}</span>
                                        {{/haspercentage}}
                                    </td>
                                    <td class="text-center">{{detected}}</td>
                                    <td class="text-center">{{verify}}</td>
                                    <td class="text-center">{{missing}}</td>
                                    <td class="text-center">{{na}}</td>
                                </tr>
                                {{/indicators}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {{/criteria}}
        </div>

        <div class="tab-pane fade" id="weakpoints-content" role="tabpanel" aria-labelledby="weakpoints-tab">
            <div class="mb-3">
                <h5 class="mb-1">{{#str}} campaign_weakpoints_title, local_qualiscope {{/str}}</h5>
                <p class="text-muted small mb-0">{{#str}} campaign_weakpoints_desc, local_qualiscope {{/str}}</p>
            </div>
            {{#hasweakpoints}}
            <div class="row g-3">
                {{#weakpoints}}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 bg-white border {{borderclass}} shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-light text-dark border">I{{number}} (C{{criterion_number}})</span>
                                <span class="badge {{percentageclass}}">{{percentage}}%</span>
                            </div>
                            <h6 class="card-title text-dark fw-bold">{{title}}</h6>
                            <div class="progress mb-2" style="height: 8px;">
                                <div class="progress-bar {{percentageclass}}" style="width: {{percentage}}%;"></div>
                            </div>
                            <div class="small text-danger fw-semibold mb-2">
                                <i class="fa fa-exclamation-circle me-1" aria-hidden="true"></i> {{failingmessage}}
                            </div>
                            <div class="d-flex justify-content-between text-muted small border-top pt-2">
                                <span>✓ {{detected}}</span>
                                <span>⚠ {{verify}}</span>
                                <span>✗ {{missing}}</span>
                                <span>— {{na}}</span>
                            </div>
                        </div>
                    </div>
                </div>
                {{/weakpoints}}
            </div>
            {{/hasweakpoints}}
            {{^hasweakpoints}}
            <div class="alert alert-success d-flex align-items-center">
                <i class="fa fa-check-circle fs-4 me-2" aria-hidden="true"></i>
                <span>{{#str}} campaign_all_compliant, local_qualiscope {{/str}}</span>
            </div>
            {{/hasweakpoints}}
        </div>

        <div class="tab-pane fade" id="capa-content" role="tabpanel" aria-labelledby="capa-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-1">{{#str}} campaign_actions_title, local_qualiscope {{/str}}</h5>
                    <p class="text-muted small mb-0">{{#str}} campaign_actions_desc, local_qualiscope {{/str}}</p>
                </div>
                <div>
                    <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#bulkActionForm" aria-expanded="false" aria-controls="bulkActionForm">
                        <i class="fa fa-plus-circle me-1" aria-hidden="true"></i> {{#str}} campaign_bulk_action_create, local_qualiscope {{/str}}
                    </button>
                </div>
            </div>

            <!-- Bulk Action Form Collapse -->
            <div class="collapse mb-4" id="bulkActionForm">
                <div class="card card-body bg-light border shadow-none">
                    <h6 class="fw-bold mb-2">{{#str}} campaign_bulk_action_create, local_qualiscope {{/str}}</h6>
                    <p class="text-muted small mb-3">{{#str}} campaign_bulk_action_help, local_qualiscope {{/str}}</p>
                    <form method="post" action="{{{bulkactionurl}}}">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="campaignid" value="{{campaignid}}">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">{{#str}} campaign_bulk_action_target_indicator, local_qualiscope {{/str}}</label>
                                <select name="indicatorid" class="form-select form-select-sm">
                                    <option value="0">{{#str}} campaign_bulk_action_target_all, local_qualiscope {{/str}}</option>
                                    {{#indicatorslist}}
                                    <option value="{{id}}">{{label}}</option>
                                    {{/indicatorslist}}
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">{{#str}} action_name, local_qualiscope {{/str}}</label>
                                <input type="text" name="title" class="form-control form-control-sm" required placeholder="Ex: Corriger les éléments manquants / vérifier les critères">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">{{#str}} action_responsible, local_qualiscope {{/str}}</label>
                                <input type="text" name="responsible" class="form-control form-control-sm" placeholder="Ex: Responsable pédagogique">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">{{#str}} action_duedate, local_qualiscope {{/str}}</label>
                                <input type="date" name="duedate" class="form-control form-control-sm">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">{{#str}} action_priority, local_qualiscope {{/str}}</label>
                                <select name="priority" class="form-select form-select-sm">
                                    <option value="high">{{#str}} action_priority_high, local_qualiscope {{/str}}</option>
                                    <option value="medium" selected>{{#str}} action_priority_medium, local_qualiscope {{/str}}</option>
                                    <option value="low">{{#str}} action_priority_low, local_qualiscope {{/str}}</option>
                                </select>
                            </div>
                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fa fa-check me-1" aria-hidden="true"></i> {{#str}} campaign_bulk_action_submit, local_qualiscope {{/str}}
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Action metrics summary bar -->
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="card shadow-none bg-light text-center p-2">
                        <span class="small text-muted">{{#str}} campaign_action_todo_count, local_qualiscope {{/str}}</span>
                        <span class="fs-5 fw-bold text-danger">{{actionstodo}}</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-none bg-light text-center p-2">
                        <span class="small text-muted">{{#str}} campaign_action_inprogress_count, local_qualiscope {{/str}}</span>
                        <span class="fs-5 fw-bold text-primary">{{actionsinprogress}}</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-none bg-light text-center p-2">
                        <span class="small text-muted">{{#str}} campaign_action_closed_count, local_qualiscope {{/str}}</span>
                        <span class="fs-5 fw-bold text-success">{{actionsclosed}}</span>
                    </div>
                </div>
            </div>

            {{#hasactions}}
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>{{#str}} campaign_course, local_qualiscope {{/str}}</th>
                            <th>{{#str}} action_name, local_qualiscope {{/str}}</th>
                            <th>{{#str}} action_responsible, local_qualiscope {{/str}}</th>
                            <th>{{#str}} action_duedate, local_qualiscope {{/str}}</th>
                            <th>{{#str}} action_priority, local_qualiscope {{/str}}</th>
                            <th>{{#str}} action_status, local_qualiscope {{/str}}</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#actions}}
                        <tr>
                            <td><strong>{{coursename}}</strong></td>
                            <td>{{title}}</td>
                            <td>{{responsible}}</td>
                            <td>{{duedateformatted}}</td>
                            <td>
                                <span class="badge {{#priorityhigh}}bg-danger{{/priorityhigh}}{{#prioritymedium}}bg-warning{{/prioritymedium}}{{#prioritylow}}bg-secondary{{/prioritylow}}">
                                    {{prioritylabel}}
                                </span>
                            </td>
                            <td>
                                <span class="badge {{#statustodo}}bg-danger{{/statustodo}}{{#statusinprogress}}bg-primary{{/statusinprogress}}{{#statusclosed}}bg-success{{/statusclosed}}">
                                    {{statuslabel}}
                                </span>
                            </td>
                            <td class="text-end">
                                <a href="{{{editurl}}}" class="btn btn-sm btn-outline-secondary">
                                    <i class="fa fa-pencil" aria-hidden="true"></i> {{#str}} edit, core {{/str}}
                                </a>
                            </td>
                        </tr>
                        {{/actions}}
                    </tbody>
                </table>
            </div>
            {{/hasactions}}
            {{^hasactions}}
            <div class="alert alert-info">
                {{#str}} campaign_no_actions, local_qualiscope {{/str}}
            </div>
            {{/hasactions}}
        </div>
    </div>
    {{/hasresults}}

    {{^hasresults}}
    <div class="row">
        <div class="col-12">
            <div class="alert alert-info">
                {{#str}} no_results, local_qualiscope {{/str}} —
                <a href="{{{runurl}}}">{{#str}} campaign_run, local_qualiscope {{/str}}</a>
            </div>
        </div>
    </div>
    {{/hasresults}}

    <div class="row mt-3">
        <div class="col-12">
            <a href="{{{backurl}}}" class="btn btn-outline-secondary">{{#str}} nav_campaigns, local_qualiscope {{/str}}</a>
        </div>
    </div>
</div>