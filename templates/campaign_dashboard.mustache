<div class="qualiscope-campaign-dashboard container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-1">{{campaignname}}</h3>
                <span class="badge {{#completed}}bg-success{{/completed}}{{^completed}}bg-primary{{/completed}}">
                    {{#completed}}
                    {{#str}} campaign_status_completed, local_qualiscope {{/str}}
                    {{/completed}}
                    {{^completed}}
                    {{#str}} campaign_status_running, local_qualiscope {{/str}}
                    {{/completed}}
                </span>
            </div>
            <div>
                {{^completed}}
                <a href="{{{runurl}}}" class="btn btn-primary">{{#str}} campaign_run, local_qualiscope {{/str}}</a>
                {{/completed}}
                {{#completed}}
                <a href="{{{rerunurl}}}" class="btn btn-outline-primary">{{#str}} campaign_rerun, local_qualiscope {{/str}}</a>
                {{/completed}}
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 text-muted">
            <strong>{{#str}} campaign_referential, local_qualiscope {{/str}} :</strong> {{referential}} |
            <strong>{{#str}} campaign_scope, local_qualiscope {{/str}} :</strong> {{scopelabel}} |
            <strong>{{#str}} campaign_date, local_qualiscope {{/str}} :</strong> {{dateformatted}}
        </div>
    </div>

    <div class="row mb-4">
        {{#summaryitems}}
        <div class="col-md-2 col-sm-6 mb-3">
            <div class="card shadow-none {{bgclass}} h-100">
                <div class="card-body p-3">
                    <div class="text-muted small mb-1">{{label}}</div>
                    <div class="fs-4 fw-bold lh-1">{{value}}</div>
                </div>
            </div>
        </div>
        {{/summaryitems}}
    </div>

    {{#hasresults}}
    <div class="row">
        <div class="col-12">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>{{#str}} campaign_course, local_qualiscope {{/str}}</th>
                        <th>{{#str}} dashboard_score, local_qualiscope {{/str}}</th>
                        <th class="text-center">✓</th>
                        <th class="text-center">⚠</th>
                        <th class="text-center">✗</th>
                        <th class="text-center">—</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#courses}}
                    <tr>
                        <td>{{coursename}}</td>
                        <td><span class="badge {{percentageclass}}">{{percentage}}%</span></td>
                        <td class="text-center">{{detected}}</td>
                        <td class="text-center">{{verify}}</td>
                        <td class="text-center">{{missing}}</td>
                        <td class="text-center">{{na}}</td>
                        <td class="text-end"><a href="{{{viewurl}}}" class="btn btn-sm btn-outline-primary">{{#str}} view, core {{/str}}</a></td>
                    </tr>
                    {{/courses}}
                </tbody>
            </table>
        </div>
    </div>
    {{/hasresults}}

    {{^hasresults}}
    <div class="row">
        <div class="col-12">
            <div class="alert alert-info">
                {{#str}} no_results, local_qualiscope {{/str}} —
                <a href="{{{runurl}}}">{{#str}} campaign_run, local_qualiscope {{/str}}</a>
            </div>
        </div>
    </div>
    {{/hasresults}}

    <div class="row mt-3">
        <div class="col-12">
            <a href="{{{backurl}}}" class="btn btn-outline-secondary">{{#str}} nav_campaigns, local_qualiscope {{/str}}</a>
        </div>
    </div>
</div>